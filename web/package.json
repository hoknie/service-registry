{
  "name": "svc-registry-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "check-export": "node scripts/check-export.mjs",
    "precompress": "node scripts/precompress.mjs",
    "lint": "eslint . && node scripts/check-comments.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check-export"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@xyflow/react": "12.12.0",
    "clsx": "2.1.1",
    "lucide-react": "1.54.0",
    "markdown-it": "15.0.3",
    "next": "16.4.2",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
