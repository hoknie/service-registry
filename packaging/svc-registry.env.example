# svc-registry settings for an installed service: the systemd unit and the macOS LaunchAgent read
# this file before `db:migrate` and `serve`. Every variable the binary knows is described in
# docs/env.example; only the ones an installation usually needs are listed here.

# Postgres 15+ the service owns, e.g. postgres://registry:secret@127.0.0.1:5432/registry
# The service does not start while this is empty.
DATABASE_URL=

# Where the server listens; put a reverse proxy with TLS in front of it.
HTTP_ADDR=127.0.0.1:8080
# The address users and forges reach the registry at (OAuth callbacks, forge webhooks).
# PUBLIC_URL=https://registry.example

# Session cookies only over HTTPS. Browsers treat http://127.0.0.1 and http://localhost as secure,
# so signing in there works; set false only for plain HTTP on another address.
# SESSION_COOKIE_SECURE=true

# The interface and the uploaded files; the package sets both paths.
WEB_DIST_DIR=
UPLOADS_DIR=

# <id>:<base64 of 32 bytes>[,...]; encrypts secrets in the database. The installation generates one.
SECRETS_KEYS=

# The first superadmin, created only while the database has no users. The installation generates
# the password and also writes it to initial-password next to this file; remove both lines after
# the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Directories local documentation sources may read, comma-separated.
# KNOWLEDGE_LOCAL_ROOTS=/srv/docs

# debug | info | warn | error
LOG_LEVEL=info
