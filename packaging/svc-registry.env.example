# svc-registry settings for an installed service: the systemd unit and the macOS LaunchAgent read
# this file before `db:migrate` and `serve`. Every variable the binary knows is described in
# docs/env.example; only the ones an installation usually needs are listed here.

# Postgres 15+ the service owns, e.g. postgres://registry:secret@127.0.0.1:5432/registry
# The service does not start while this is empty.
DATABASE_URL=

# Where the server listens; put a reverse proxy with TLS in front of it.
HTTP_ADDR=127.0.0.1:8080
# The address users and forges reach the registry at (OAuth callbacks, forge webhooks).
# PUBLIC_URL=https://registry.example

# Session cookies only over HTTPS. Browsers treat http://127.0.0.1 and http://localhost as secure,
# so signing in there works; set false only for plain HTTP on another address.
# SESSION_COOKIE_SECURE=true

# The interface and the uploaded files; the package sets both paths.
WEB_DIST_DIR=
UPLOADS_DIR=
# Uploaded link icons nothing refers to are deleted after this many seconds (600..2592000, default one day).
# UPLOADS_UNREFERENCED_TTL_SECS=86400

# <id>:<base64 of 32 bytes>[,...]; encrypts secrets in the database. The installation generates one.
SECRETS_KEYS=

# The first superadmin, created only while the database has no users. The installation generates
# the password and also writes it to initial-password next to this file; remove both lines after
# the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Outbound proxy for forges, OIDC and embeddings; notifications use it only with NOTIFY_USE_PROXY=true
# (the receiver's IP behind the proxy is then not checked, see docs/notifications.md).
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=.corp.example
# NOTIFY_USE_PROXY=false

# Largest report of a cluster agent after decompression, bytes (64 MiB by default).
# K8S_AGENT_REPORT_MAX_BYTES=67108864

# MCP clients over OAuth (docs/mcp.md): the registry becomes an OAuth 2.1 authorization server for
# /api/mcp, clients ask for consent in the browser instead of a pasted token. Needs PUBLIC_URL, and the
# reverse proxy must pass /.well-known/oauth-* and /api/oauth/ through unchanged.
# MCP_OAUTH=on
# Lifetime of an app access token in seconds (300..86400) and of a refresh token in days (1..365).
# MCP_OAUTH_ACCESS_TTL_SECS=3600
# MCP_OAUTH_REFRESH_DAYS=30
# Clients may use the https:// address of their metadata document as client_id, but only from the hosts
# listed here (host or *.domain, comma-separated; empty — no documents are accepted). The document is never
# fetched from private or loopback addresses.
# MCP_OAUTH_CLIENT_METADATA=on
# MCP_OAUTH_CLIENT_METADATA_HOSTS=
# true: fetch documents through HTTPS_PROXY/HTTP_PROXY (networks without direct access out); the IP of the
# document's host behind the proxy is not checked.
# MCP_OAUTH_CLIENT_METADATA_USE_PROXY=false

# Directories local documentation sources may read, comma-separated.
# KNOWLEDGE_LOCAL_ROOTS=/srv/docs

# debug | info | warn | error
LOG_LEVEL=info
