<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>svc-registry @VERSION@</title>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="svc-registry">
        <pkg-ref id="@IDENTIFIER@"/>
    </choice>
    <pkg-ref id="@IDENTIFIER@" version="@VERSION@" onConclusion="none">svc-registry-component.pkg</pkg-ref>
</installer-gui-script>
