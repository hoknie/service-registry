#!/bin/sh
# Run by the LaunchAgent: read the settings, apply migrations, then serve. Exits 0 (and launchd does
# not restart it) while DATABASE_URL is empty.
#   launch <settings file>

set -eu

settings="$1"
PREFIX="${SVC_REGISTRY_PREFIX:-/usr/local}"
BINARY="$PREFIX/bin/svc-registry"

[ -f "$settings" ] || { echo "svc-registry: $settings is missing; run $PREFIX/libexec/svc-registry/setup" >&2; exit 0; }
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
    ""|"#"*) continue ;;
    *=*) ;;
    *) continue ;;
    esac
    key="${line%%=*}"
    value="${line#*=}"
    case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
    \'*\') value="${value#\'}"; value="${value%\'}" ;;
    esac
    export "$key=$value"
done < "$settings"

if [ -z "${DATABASE_URL:-}" ]; then
    echo "svc-registry: set DATABASE_URL in $settings, then: launchctl kickstart -k gui/$(id -u)/io.github.hoknie.svc-registry" >&2
    exit 0
fi

"$BINARY" db:migrate
exec "$BINARY" serve
