# svc-registry configuration. Every variable the binary reads, with its default.
# `cp .env.example .env` — just loads .env for every recipe (the binary reads only the
# process environment). Empty values count as unset.

# ---- database (serve, db:migrate, db:rollback) ----
# Required. postgres:// or postgresql:// (dev DB from docker-compose: pgsql on :5440).
DATABASE_URL=postgres://registry:registry@127.0.0.1:5440/registry
# Pool size, 1..=1000.
DATABASE_MAX_CONNECTIONS=10
# Seconds to wait for a connection, 1..=300; also bounds the /api/ready check.
DATABASE_ACQUIRE_TIMEOUT_SECS=3

# ---- HTTP ----
# Listen address host:port.
HTTP_ADDR=0.0.0.0:8080
# Seconds in-flight requests may finish after SIGTERM / Ctrl-C, 0..=300.
SHUTDOWN_TIMEOUT_SECS=10

# ---- web UI ----
# Directory with the static export of the web UI (`just web-build` → web/out); every non-/api
# request is served from it. Relative to the working directory. Not checked at start: without
# an export the UI answers 503, the API keeps working.
WEB_DIST_DIR=web/out

# ---- sessions ----
# `Secure` attribute of the session cookie: true|false. false ONLY for local plain http in a
# browser that does not treat the host as a secure context.
SESSION_COOKIE_SECURE=true
# A session unused this long expires, 60..=2592000 (12 h).
SESSION_IDLE_TIMEOUT_SECS=43200
# A session expires this long after sign-in, 60..=31536000, >= idle (7 days).
SESSION_ABSOLUTE_TIMEOUT_SECS=604800

# ---- password hashing (serve, user:create; argon2id) ----
# Parameters of NEW hashes; old hashes keep theirs. OWASP defaults.
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_ITERATIONS=2
PASSWORD_HASH_PARALLELISM=1

# ---- failed sign-in throttling (serve; per client IP + email, in memory) ----
# Failures allowed in one window, 1..=1000; then 429 auth.rate_limited until it ends.
LOGIN_MAX_FAILURES=5
# Window opened by the first failure, seconds, 1..=86400.
LOGIN_FAILURE_WINDOW_SECS=900

# ---- event ingest ----
# Accepted raw events are deleted after this many days, 1..=3650 (deployment history stays).
INGEST_EVENT_RETENTION_DAYS=90
# Ingest requests per project key per minute (in memory, per process), 1..=100000; then 429.
INGEST_RATE_LIMIT_PER_MINUTE=600

# ---- personal access tokens ----
# Longest lifetime a token may be issued with, days, 1..=3650 (superadmins may also issue
# tokens without expiry).
PAT_MAX_LIFETIME_DAYS=365

# ---- secrets in the database ----
# <id>:<base64 of 32 bytes>[,...]; the first key encrypts, all decrypt (rotation:
# `svc-registry secrets:rotate`). Generate: printf 'k1:%s\n' "$(openssl rand -base64 32)".
# Unset — forge tokens can only be references (env:NAME / file:/path).
# SECRETS_KEYS=

# ---- outgoing HTTP(S) to forges ----
# PEM file with extra root certificates (self-hosted forge with an internal CA).
# HTTP_CA_FILE=
# Limit of one outgoing request, seconds, 1..=600.
HTTP_CLIENT_TIMEOUT_SECS=30
# Standard proxy variables (lower-case spellings work too).
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=

# ---- external address (webhook URLs) ----
# http(s)://host[:port][/path] without a trailing slash.
# PUBLIC_URL=https://registry.example

# ---- background jobs and forge sync ----
# false — this replica serves the API only.
BACKGROUND_JOBS_ENABLED=true
# Concurrent sync runs per process, 1..=32.
FORGE_SYNC_CONCURRENCY=2
# Default sync interval of a new connection, seconds, 60..=86400.
FORGE_SYNC_INTERVAL_SECS=900
# Runs kept per connection, 1..=1000.
FORGE_SYNC_RUNS_KEPT=20

# ---- project branches ----
# Days a branch gone from its forge is kept, 1..=3650 (default and pinned branches: forever).
BRANCH_RETENTION_DAYS=30
# Days without activity before a branch counts as stale, 1..=3650; branches without a forge
# source are deleted after BRANCH_RETENTION_DAYS + BRANCH_STALE_DAYS without activity.
BRANCH_STALE_DAYS=90
# Branches of one repository a forge sync takes, 1..=10000.
BRANCH_SYNC_MAX_PER_REPO=500

# ---- observability link checks ----
# How often each known link address is checked, seconds, 300..=604800.
LINK_CHECK_INTERVAL_SECS=3600
# Limit of one check, seconds, 1..=60.
LINK_CHECK_TIMEOUT_SECS=5
# Concurrent checks per process, 1..=64 (and at most 2 per host).
LINK_CHECK_CONCURRENCY=4
# Check addresses in private networks (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7).
# Loopback, link-local (cloud metadata), multicast and unspecified are never checked.
LINK_CHECK_ALLOW_PRIVATE=true
# Hosts (name or *.domain, comma-separated) checked in private networks even when
# LINK_CHECK_ALLOW_PRIVATE=false.
# LINK_CHECK_ALLOW_HOSTS=*.corp.example
# Hosts (name or *.domain, comma-separated) never checked.
# LINK_CHECK_DENY_HOSTS=
# Checks kept per address, 1..=1000.
LINK_CHECK_HISTORY=20
# Days an address no link expansion produced is kept (with its history), 1..=3650.
LINK_CHECK_TARGET_TTL_DAYS=30

# ---- Kubernetes clusters ----
# Clusters polled at once per process, 1..=32 (BACKGROUND_JOBS_ENABLED=false stops polling).
K8S_POLL_CONCURRENCY=2
# Limit of one request to a cluster's API server, seconds, 1..=120.
K8S_REQUEST_TIMEOUT_SECS=10
# Objects per page of a list, 50..=5000.
K8S_LIST_LIMIT=500
# Seconds a version seen in a cluster waits for a service.deployed event of the same version
# before it is recorded as a deployment with source "cluster", 0..=86400.
K8S_HISTORY_CONFIRM_SECS=600
# Days the observation of a vanished workload is kept, 1..=365.
K8S_WORKLOAD_RETENTION_DAYS=7

# ---- project documentation and MCP ----
# Seconds after a new branch head within which a documentation snapshot is taken, 30..=86400.
KNOWLEDGE_INTERVAL_SECS=300
# Seconds before a failed collection is retried, 60..=86400.
KNOWLEDGE_RETRY_SECS=900
# Collections at once per process, 1..=16 (BACKGROUND_JOBS_ENABLED=false stops collecting).
KNOWLEDGE_COLLECT_CONCURRENCY=2
# Snapshots of a branch kept besides the latest, 0..=100.
KNOWLEDGE_KEEP=5
# Scan history entries kept per project and kind (collection, indexing), 1..=1000.
KNOWLEDGE_SCAN_HISTORY=20
# Largest stored file, bytes, 1024..=10485760.
KNOWLEDGE_MAX_FILE_BYTES=524288
# Files in a snapshot, 1..=50000.
KNOWLEDGE_MAX_FILES=2000
# Stored content of a snapshot, bytes, 65536..=268435456.
KNOWLEDGE_MAX_SNAPSHOT_BYTES=16777216
# Largest result of an MCP tool, bytes, 4096..=4194304.
KNOWLEDGE_MCP_MAX_RESULT_BYTES=262144
# Absolute directories (comma-separated) local documentation sources (a folder or a git
# repository) must lie in; empty — local sources are off.
# KNOWLEDGE_LOCAL_ROOTS=/srv/docs,/srv/repos

# ---- documentation search engines ----
# postgres (full text, default) | pgvector (needs the vector extension) | qdrant | meilisearch.
# KNOWLEDGE_SEARCH_ENGINE=postgres
# Embeddings for the semantic and hybrid modes: any OpenAI-compatible API (OpenAI, Ollama, vLLM, LM Studio).
# Ollama example: EMBEDDINGS_URL=http://localhost:11434/v1, EMBEDDINGS_MODEL=nomic-embed-text, EMBEDDINGS_DIMENSIONS=768.
# EMBEDDINGS_URL=
# EMBEDDINGS_MODEL=
# EMBEDDINGS_API_KEY=env:OPENAI_API_KEY
# EMBEDDINGS_DIMENSIONS=
# EMBEDDINGS_BATCH=32
# KNOWLEDGE_CHUNK_CHARS=1500
# KNOWLEDGE_INDEX_INTERVAL_SECS=60
# QDRANT_URL=localhost:6334
# QDRANT_API_KEY=
# QDRANT_COLLECTION=svc_registry_docs
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=
# MEILISEARCH_INDEX=svc_registry_docs

# ---- login ----
# Who may sign in with a password: all, superadmins (emergency access) or off (needs a provider).
AUTH_PASSWORD_LOGIN=all
# OIDC providers, comma-separated keys; each needs PUBLIC_URL (callback:
# <PUBLIC_URL>/api/v1/auth/oauth/<key>/callback) and its OAUTH_<KEY>_* variables, e.g.:
# OAUTH_PROVIDERS=corp
# OAUTH_CORP_KIND=oidc                        # oidc or gitlab (issuer https://gitlab.com by default)
# OAUTH_CORP_ISSUER=https://sso.example.com/realms/main
# OAUTH_CORP_CLIENT_ID=svc-registry
# OAUTH_CORP_CLIENT_SECRET=env:CORP_CLIENT_SECRET   # a value or env:NAME / file:/path
# OAUTH_CORP_DISPLAY_NAME=Corporate SSO
# OAUTH_CORP_SCOPES=openid profile email      # default; gitlab adds read_user
# OAUTH_CORP_AUTO_PROVISION=false             # create unknown users at first login
# OAUTH_CORP_ALLOWED_DOMAINS=example.com      # email domains for auto-provisioning; empty — any
# OAUTH_CORP_GROUPS_CLAIM=groups              # gitlab: groups_direct
# OAUTH_CORP_GROUP_MAP=platform-team=>Platform;*   # value=>group; "*" — a group per value

# ---- first superadmin ----
# Both or neither. Created on start only when the users table is empty; remove afterwards.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# ---- user:create ----
# Password of the user `svc-registry user:create` creates; unset → first line of stdin.
# Never passed as an argument.
# USER_PASSWORD=

# ---- logging (all commands) ----
# A level (off|error|warn|info|debug|trace) or target=level list, e.g. info,pgx=warn (the bare level applies).
LOG_LEVEL=info

# ---- tests only (go test) ----
# Throwaway Postgres for DB tests (pgsql-test on :5434); each test makes its own schema.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/postgres
